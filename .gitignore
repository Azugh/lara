    <!-- Мета-тег для CSRF токена -->
    <meta name="csrf-token" content="{{ csrf_token() }}">

    <script>
        $(document).ready(function() {
            // Настройка CSRF для всех AJAX запросов
            $.ajaxSetup({
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                }
            });

            // Увеличение количества товара
            $('.increase-quantity').on('click', function() {
                const cartItemId = $(this).data('cart-item-id');
                const itemId = $(this).data('item-id');

                $.ajax({
                    url: '/cart/increase/' + itemId,
                    method: 'POST',
                    data: {
                        cart_item_id: cartItemId
                    },
                    success: function(response) {
                        if (response.success) {
                            // Обновляем количество
                            $('#quantity-' + cartItemId).text(response.quantity);
                            // Обновляем цену за позицию
                            $('#price-' + cartItemId).text(response.item_total_price + ' руб.');
                            // Обновляем общую сумму
                            $('#total-price').text(response.total_price);
                            $('#total-quantity').text(response.total_quantity);

                            // Показываем сообщение об успехе
                            showToast('Количество товара увеличено');
                        }
                    },
                    error: function(xhr) {
                        showToast('Ошибка при обновлении количества', 'error');
                    }
                });
            });

            // Уменьшение количества товара
            $('.decrease-quantity').on('click', function() {
                const cartItemId = $(this).data('cart-item-id');
                const itemId = $(this).data('item-id');

                $.ajax({
                    url: '/cart/decrease/' + itemId,
                    method: 'POST',
                    data: {
                        cart_item_id: cartItemId
                    },
                    success: function(response) {
                        if (response.success) {
                            if (response.removed) {
                                // Удаляем строку из таблицы
                                $('#cart-item-' + cartItemId).remove();

                                // Если корзина пуста, перезагружаем страницу
                                if (response.total_quantity === 0) {
                                    location.reload();
                                }
                            } else {
                                // Обновляем количество
                                $('#quantity-' + cartItemId).text(response.quantity);
                                // Обновляем цену за позицию
                                $('#price-' + cartItemId).text(response.item_total_price + ' руб.');
                            }

                            // Обновляем общую сумму
                            $('#total-price').text(response.total_price);
                            $('#total-quantity').text(response.total_quantity);

                            showToast('Количество товара уменьшено');
                        }
                    },
                    error: function(xhr) {
                        showToast('Ошибка при обновлении количества', 'error');
                    }
                });
            });

            // Удаление товара из корзины
            $('.remove-item').on('click', function() {
                const cartItemId = $(this).data('cart-item-id');

                if (confirm('Вы уверены, что хотите удалить этот товар из корзины?')) {
                    $.ajax({
                        url: '/cart/remove/' + cartItemId,
                        method: 'DELETE',
                        success: function(response) {
                            if (response.success) {
                                // Удаляем строку из таблицы
                                $('#cart-item-' + cartItemId).remove();

                                // Если корзина пуста, перезагружаем страницу
                                if (response.total_quantity === 0) {
                                    location.reload();
                                } else {
                                    // Обновляем общую сумму
                                    $('#total-price').text(response.total_price);
                                    $('#total-quantity').text(response.total_quantity);
                                }

                                showToast('Товар удален из корзины');
                            }
                        },
                        error: function(xhr) {
                            showToast('Ошибка при удалении товара', 'error');
                        }
                    });
                }
            });

            // Функция для показа уведомлений
            function showToast(message, type = 'success') {
                // Создаем элемент для уведомления
                let toast = $('<div class="toast">' + message + '</div>');

                // Стили для уведомления
                toast.css({
                    'position': 'fixed',
                    'top': '20px',
                    'right': '20px',
                    'padding': '15px',
                    'background-color': type === 'success' ? '#28a745' : '#dc3545',
                    'color': 'white',
                    'border-radius': '5px',
                    'z-index': '9999',
                    'transition': 'opacity 0.3s'
                });

                // Добавляем на страницу
                $('body').append(toast);

                // Удаляем через 3 секунды
                setTimeout(function() {
                    toast.fadeOut(300, function() {
                        $(this).remove();
                    });
                }, 3000);
            }
        });
    </script>
@endsection
